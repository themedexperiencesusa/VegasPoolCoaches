# Server Configuration
PORT=3000
NODE_ENV=development

# Database
# Local MongoDB (no authentication)
MONGODB_URI=mongodb://localhost:27017/vegas-pool-coaches
MONGODB_TEST_URI=mongodb://localhost:27017/vegas-pool-coaches-test

# MongoDB with authentication (recommended for production)
# MONGODB_URI=mongodb://username:password@localhost:27017/vegas-pool-coaches?authSource=admin

# MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vegas-pool-coaches?retryWrites=true&w=majority

# Docker MongoDB (with authentication)
# MONGODB_URI=mongodb://root:password123@localhost:27017/vegas-pool-coaches?authSource=admin

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# OpenAI API (for AI-powered pool consulting)
OPENAI_API_KEY=your-openai-api-key

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password

# Pool Water Chemistry API (if using external services)
WATER_CHEMISTRY_API_KEY=your-water-chemistry-api-key

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads